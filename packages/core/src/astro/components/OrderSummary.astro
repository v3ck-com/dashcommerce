---
// OrderSummary — post-checkout thank-you page.
//
// Renders a polling island that hits /orders/by-draft/:orderDraftId
// until the webhook/reconciliation path has persisted the order. Hosted
// payment providers return the customer with the private draft id in the URL.

import OrderSummaryIsland from "../islands/OrderSummaryIsland.tsx";

interface Props {
	orderDraftId: string;
}

const { orderDraftId } = Astro.props;
---
<OrderSummaryIsland client:load orderDraftId={orderDraftId} />
