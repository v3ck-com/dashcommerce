{
  "name": "dashcommerce-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "DashCommerce — the WooCommerce-equivalent commerce plugin for the EmDash ecosystem",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "test": "bun run --filter '*' test",
    "test:host": "node --test packages/starter/test/emdash-041-host.test.mjs && node scripts/host-http-smoke.mjs",
    "test:http": "node scripts/test-paystack-http.mjs",
    "test:browser": "playwright test --config packages/starter/playwright.config.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "postinstall": "bun run --cwd packages/core build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.16.0",
    "bun": ">=1.4.2"
  }
}
